@{
    ViewData["Title"] = "Home Page";
}

<style>
    .select2-container--bootstrap-5 .select2-selection {
      /*   min-height: 45px; */
        padding: 6px 12px;
    }
</style>
<div class="row">
    <div class="col-lg-12 mb-4 order-0">
        <div class="card">
            <div class="card-body">
                <h4>ادارة الامراض / @ViewBag.EmployeeName</h4>
                <p>
                    <button type="button" id="addBeneficiaryDisease"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#createModal">
                        اضافة
                    </button>
                </p>

                <table id="myTable" class="table table-striped table-bordered table-dark" style="width:100%">
                    <thead>
                        <tr>
                            <th> (ID)</th>
                            <th>المرض</th>
                            <th>عمليات</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="addForm">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel3">Modal title</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col mb-3">
                        <label for="addDisease" class="form-label">Name</label>
                        <select type="text" class="form-control select2" id="addDisease" name="addDisease" placeholder="Enter Disease" autocomplete="off"></select>
                    </div>
                </div>
            </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="updateForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel3">نعديل </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col mb-3">
                            <input type="hidden" id="edid" />
                            <label for="edDisease" class="form-label">Name</label>
                            <select type="text" class="form-control select2" id="edDisease" name="edDisease" placeholder="Enter Disease" autocomplete="off"></select>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="bs-toast toast toast-placement-ex m-2 fade bg-success top-0 end-0"
     id="successToast"
     role="alert"
     aria-live="assertive"
     aria-atomic="true"
     data-bs-delay="3000">
    <div class="toast-header">
        <i class="bx bx-bell me-2"></i>
        <div class="me-auto fw-semibold">إشعار النجاح</div>
        <small>الآن</small>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
    <div class="toast-body" id="successToastBody">
        تمت إضافة السنة بنجاح!
    </div>
</div>

@section Scripts {
    <script>
        var apiBaseUrl = "@ViewBag.ApiBaseUrl";
        var BeneficiaryId= "@ViewBag.BeneficiaryId";

        $(document).ready(function () {
            // قراءة الرابط من الـ ViewBag وتخزينه في متغير جافاسكريبت
            var form = document.getElementById('addForm');

         $('#myTable').DataTable({
            "ajax": {
                "url": apiBaseUrl + "api/BeneficiaryDisease/ByEmployee/" + BeneficiaryId,
                "type": "GET",
                "dataSrc": "data" // صحيح، لأن البيانات مغلفة داخل data
            },
            "columns": [
                { "data": "id" },
                { "data": "disease.name" }, // تأكد أنها تطابق الـ JSON تماماً
                {
                    "data": null,
                    "orderable": false,
                    "width": "70px",
                    "className": "text-center",
                    "render": function (data, type, row) {
                        // التعديل هنا: استخدم row.diseaseName بدلاً من row.name
                        return `
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="javascript:void(0);" onclick="editBeneficiaryDisease(${row.id})">
                                        <i class="bx bx-edit-alt me-1"></i> تعديل
                                    </a>
                                    <a class="dropdown-item" href="javascript:void(0);" onclick="viewDetails(${row.id})">
                                        <i class="bx bx-show-alt me-1"></i> تفاصيل
                                    </a>
                                    <a class="dropdown-item text-danger" href="javascript:void(0);" onclick="deleteBeneficiaryDisease(${row.id})">
                                        <i class="bx bx-trash me-1"></i> حذف
                                    </a>
                                </div>
                            </div>
                        `;
                    }
                }
            ],
            "language": {
                "search": "بحث:",
                "paginate": {
                    "next": "التالي",
                    "previous": "السابق"
                }
            },
            "autoWidth": false
        });



            $('#createModal').on('shown.bs.modal', function () {
            $('#addDisease').select2({
                dropdownParent: $('#createModal'),
                width: '100%',
                placeholder: "-- اختر المرض --",
                allowClear: true
            });

        });

            $('#updateModal').on('shown.bs.modal', function () {

            $('#edDisease').select2({
                dropdownParent: $('#updateModal'),
                width: '100%',
                // placeholder: "-- اختر المرض --",
                allowClear: true
            });

        });


        $("#addBeneficiaryDisease").click(function () {
            getDiseaseId();
        });

     $('#addForm').on('submit', function (e) {
            e.preventDefault();
            // تأكد من تعريف متغير form
            var form = this;

            if (!form.checkValidity()) {
                e.stopPropagation();
                $(form).addClass('was-validated');
                return;
            }

            // توحيد حالة الأحرف للمتغيرات
            var beneficiaryId = "@ViewBag.BeneficiaryId";
            var diseaseId = $('#addDisease').val(); // القيمة المختارة من القائمة
            var diseaseName = $("#addDisease option:selected").text(); // النص المختار للرسالة

            // التحقق من اختيار مرض حقيقي وليس القيمة الافتراضية -1
            if (diseaseId === "-1" || !diseaseId) {
                showToast("يرجى اختيار مرض أولاً", true);
                return;
            }
              
            // بناء الكائن بناءً على ما يتوقعه الـ API
            var data = {
                diseaseId: parseInt(diseaseId),
                beneficiaryId: parseInt(beneficiaryId),
                isActive: true
            };

            $.ajax({
                url: apiBaseUrl + "api/BeneficiaryDisease",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (response) {
                    $('#createModal').modal('hide');
                    form.reset();
                    $(form).removeClass('was-validated');

                    // إعادة ضبط Select2 للشكل الافتراضي بعد المسح
                    $('#addDisease').val('-1').trigger('change');

                    $('#myTable').DataTable().ajax.reload();

                    // استخدام اسم المرض الصحيح في الرسالة
                    showToast("تمت إضافة مرض " + diseaseName + " بنجاح");
                },
                error: function (xhr) {
                    var errorMsg = xhr.responseJSON ? xhr.responseJSON.message : "خطأ في الاتصال بالسيرفر";
                    showToast(errorMsg, true);
                }
            });
        });
    });

     function getDiseaseId() {

            var $select = $('#addDisease');

            // تفريغ القائمة
            $select.empty();

            // إضافة placeholder
            $select.append('<option></option>');

            $.ajax({
                url: apiBaseUrl + "api/Disease",
                type: "GET",
                dataType: "json",
                success: function (result) {

                    if (result && result.data) {

                        $.each(result.data, function (i, item) {

                            var option = new Option(item.name, item.id, false, false);
                            $select.append(option);

                        });

                        // تحديث Select2
                        $select.trigger('change');
                    }
                },
                error: function (err) {
                    console.error(err.responseText);
                }
            });
        }

     function getDiseaseIded() {

            var apiBaseUrl = "@ViewBag.ApiBaseUrl";
            var $select = $('#edDisease');

            return new Promise((resolve, reject) => {

                $select.empty();
                $select.append('<option></option>');

                $.ajax({
                    url: apiBaseUrl + "api/Disease",
                    type: "GET",
                    dataType: "json",
                    success: function (result) {

                        if (result && result.data) {

                            $.each(result.data, function (i, item) {
                                var option = new Option(item.name, item.id, false, false);
                                $select.append(option);
                            });

                            $select.trigger('change');
                            resolve(); // ✅ تم التحميل
                        } else {
                            reject("No data");
                        }
                    },
                    error: function (err) {
                        reject(err);
                    }
                });

            });
        }

     function deleteBeneficiaryDisease(id) {
           var apiBaseUrl = "@ViewBag.ApiBaseUrl";
             // تعريف الـ Toast باستخدام Bootstrap المدمج في القالب
             var toastElement = document.getElementById('successToast');
             var toast = new bootstrap.Toast(toastElement);
            Swal.fire({
                title: 'هل أنت متأكد؟',
                text: "لن تتمكن من التراجع عن هذا الحذف!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#696cff',
                cancelButtonColor: '#d33',
                confirmButtonText: 'نعم، احذفها!',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    // هنا تضع طلب الـ AJAX للحذف
                    $.ajax({
                        url: apiBaseUrl + "api/BeneficiaryDisease/" + id,
                        type: "DELETE",
                        success: function (response) {
                      $('#myTable').DataTable().ajax.reload();


                     showToast("تمت حذف  بنجاح");

                        },
                error: function (xhr) {
                    var errorMsg = xhr.responseJSON ? xhr.responseJSON.message : "خطأ";

                    // عرض Toast أحمر في حالة الخطأ

                    showToast(errorMsg,true);
                }
                    });
                }
            });
        }



     function showToast(message, isError = false) {
            const toastElement = $('#successToast');
            const toastBody = $('#successToastBody');

            // تغيير الرسالة
            toastBody.text(message);

            // تغيير اللون إذا كان خطأ (اختياري)
            if (isError) {
                toastElement.removeClass('bg-success').addClass('bg-danger');
            } else {
                toastElement.removeClass('bg-danger').addClass('bg-success');
            }

            // تشغيل التوست باستخدام Bootstrap 5 API
            const toast = new bootstrap.Toast(toastElement[0]);
            toast.show();
        }

     async function editBeneficiaryDisease(id) {

            var beneficiaryId = "@ViewBag.BeneficiaryId";
            var apiBaseUrl = "@ViewBag.ApiBaseUrl";

            try {

                Swal.fire({
                    title: 'جاري جلب البيانات...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                // جلب البيانات
                const response = await $.ajax({
                    url: apiBaseUrl + "api/BeneficiaryDisease/" + id,
                    type: "GET"
                });

                if (response.status === "Success") {

                    $('#edid').val(response.data.id);

                    // ننتظر تحميل الأمراض
                    await getDiseaseIded();
                    $('#edDisease').val(response.data.diseaseId).trigger('change');

                    Swal.close();

                    $("#updateModal").modal('show');
                }

            } catch (error) {

                Swal.fire('خطأ!', 'تعذر جلب البيانات', 'error');
                console.error(error);
            }
        }


                $('#updateForm').on('submit', function (e) {
            e.preventDefault();
            UpdateBeneficiaryDisease();
        });

    async function UpdateBeneficiaryDisease() {

            var apiBaseUrl = "@ViewBag.ApiBaseUrl";
            var beneficiaryId = "@ViewBag.BeneficiaryId";

            const dataToUpdate = {
                id: parseInt($('#edid').val()),
                diseaseId: $('#edDisease').val(),
                beneficiaryId: beneficiaryId,
                isActive: true
            };

            try {

                // 🔄 تحميل
                Swal.fire({
                    title: 'جاري الحفظ...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                // ✅ إرسال الطلب باستخدام await
                await $.ajax({
                    url: apiBaseUrl + "api/BeneficiaryDisease",
                    type: "PUT",
                    contentType: "application/json",
                    data: JSON.stringify(dataToUpdate)
                });

                Swal.close();

                // ✅ إغلاق المودال
                $('#updateModal').modal('hide');

                // ✅ تحديث الجدول
                $('#myTable').DataTable().ajax.reload();

                // ✅ رسالة نجاح
                showToast("تم التعديل بنجاح!");

            } catch (error) {

                Swal.close();
                showToast("حدث خطأ أثناء التعديل", true);
                console.error(error);
            }
        }





          

















    </script>
}