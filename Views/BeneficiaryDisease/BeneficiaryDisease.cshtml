@{
    ViewData["Title"] = "Home Page";
}


<div class="row">
    <div class="col-lg-12 mb-4 order-0">
        <div class="card">
            <div class="card-body">
                <h4>ادارة الامراض</h4>
                <p>

                    <button type="button" id="addBeneficiaryDisease"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#createModal">
                        اضافة
                    </button>
                </p>

                <table id="myTable" class="table table-striped table-bordered table-dark" style="width:100%">
                    <thead>
                        <tr>
                            <th> (ID)</th>
                            <th>المرض</th>
                            <th>عمليات</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>



<!-- Create Modal -->



<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="addForm">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel3">Modal title</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col mb-3">
                        <label for="addDisease" class="form-label">Name</label>
                       @*  <input type="text" id="nameLarge" class="form-control" placeholder="Enter Name" /> *@
                        <select type="text" class="form-control select2" id="addDisease" name="addDisease" placeholder="Enter Disease" autocomplete="off"></select>

                    </div>
                </div>
               
            </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="updateForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel3">نعديل </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col mb-3">
                            <input type="hidden" id="edid" />
                            <label for="edDisease" class="form-label">Name</label>
                            @*  <input type="text" id="nameLarge" class="form-control" placeholder="Enter Name" /> *@
                            <select type="text" class="form-control select2" id="edDisease" name="edDisease" placeholder="Enter Disease" autocomplete="off"></select>

                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>








