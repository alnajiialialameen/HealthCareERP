				function showToast(title, message, type = 'success') {

			const toastElement = $('#mainToast');
			const toastTitle = $('#toastTitle');
			const toastBody  = $('#toastBody');
			const toastIcon  = $('#toastIcon');

			// 🟢 النص
			toastTitle.text(title);
			toastBody.text(message);

			// 🟢 Reset كامل
			toastElement.removeClass('bg-success bg-danger bg-warning bg-info');
			toastIcon.attr('class', 'bx'); // إعادة تعيين الأيقونة

			// 🟢 تحديد النوع
			switch (type) {
				case 'success':
					toastElement.addClass('bg-success text-white');
					toastIcon.addClass('bx-check-circle');
					break;

				case 'error':
					toastElement.addClass('bg-danger text-white');
					toastIcon.addClass('bx-x-circle');
					break;

				case 'warning':
					toastElement.addClass('bg-warning text-dark');
					toastIcon.addClass('bx-error-circle');
					break;

				case 'info':
					toastElement.addClass('bg-info text-white');
					toastIcon.addClass('bx-info-circle');
					break;
			}

			// 🟢 تشغيل Toast
			const toast = new bootstrap.Toast(toastElement[0]);
			toast.show();
		}










