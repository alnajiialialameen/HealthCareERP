@{
	ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<style>
	/* Modal */
	.custom-modal {
		min-height: 600px;
		border-radius: 18px;
		box-shadow: 0 25px 60px rgba(0,0,0,.25);
	}

	/* Sidebar */
	.sidebar {
		background: #f8f9fa;
		border-left: 1px solid #ddd;
	}

		.sidebar .list-group-item {
			border: none;
			padding: 16px 18px;
			font-weight: 600;
			color: #555;
		}

			.sidebar .list-group-item.active {
				background: linear-gradient(135deg, #696cff, #5a5cff);
				color: #fff;
			}

			.sidebar .list-group-item:hover {
				background-color: #eef0ff;
			}

	/* Content */
	.content-area {
		background: #fafafa;
	}

	/* Section title */
	.section-title {
		font-weight: 700;
		margin-bottom: 25px;
		padding-bottom: 6px;
		border-bottom: 3px solid #696cff;
	}

	/* Info cards */
	.info-card {
		background: #fff;
		padding: 15px;
		border-radius: 14px;
		box-shadow: 0 6px 18px rgba(0,0,0,.08);
	}

		.info-card label {
			font-size: 14px;
			color: #777;
			margin-bottom: 6px;
			display: block;
		}

		.info-card .form-control {
			background: #f9fafb;
			border: 1px solid #e0e0e0;
			font-weight: 600;
		
		}

	/* Tables */
	.table {
		background: #fff;
		border-radius: 12px;
		overflow: hidden;
		
	}

	


		.table thead {
			background: #f1f2ff;
			font-weight: 700;
			color: #222 !important;
		}

	table:not(.table-dark) th {
		color: #222 !important;
	}


	/* Empty state blocks */
	#nodataBlock,
	#exceptionNodataBlock,
	#cardHistoryNodataBlock {
		background: #fff;
		border-radius: 14px;
		box-shadow: 0 6px 18px rgba(0,0,0,.08);
	}



	.bx-dots-vertical-rounded {
		color: #383535;
		font-size: 22px;
	}

	.card-body {
      color:black;
	  font-size: 18px;
	}


	.table-def > :not(caption) > * > * {
	
		color: var(--bs-table-color-state,var(--bs-table-color-type,black));
		
	}

	td.details-control {
		cursor: pointer;
		text-align: center;
	}

		td.details-control::before {
			content: '+';
			font-weight: bold;
			color: #0d6efd;
		}

	tr.shown td.details-control::before {
		content: '-';
	}

    
	.text-lg{
		min-width:150px;
	}



	td.details-control {
		cursor: pointer;
		text-align: center;
	}

		td.details-control::before {
			content: "";
			display: inline-block;
			width: 24px;
			height: 24px;
			background-image: url('../../temp/icons/close6.png');
			background-repeat: no-repeat;
			background-position: center;
			background-size: contain;
			cursor: pointer;
		}

		td.details-control::before {
			content: "";
			display: inline-block;
			width: 24px;
			height: 24px;
			background-image: url('../../temp/icons/close6.png');
			background-repeat: no-repeat;
			background-size: contain;
		}

	tr.shown td.details-control::before {
		background-image: url('../../temp/icons/open.png');
	}
	.margin-left {
	margin-right: 800px !important;

	}


	.label {
/* 	min-width: 140px;
 */	margin-left: 20px;
}

	.card-detail{
		background-color: #f4f4f4
	}

	table.dataTable.table-sm > thead > tr > th:not(.sorting_disabled) {
		
		text-align: right;
	}

	.form-check {
	
		color: black;
		font-size: larger;
		text-align:left;
		float: right;
	}

	

	

</style>
<div class="modal fade viewDetailModal" id="viewDetailModal"
	 data-bs-backdrop="static"
	 data-bs-keyboard="false"
	 tabindex="-1"
	 aria-hidden="true">

	<div class="modal-dialog modal-xl modal-dialog-centered">
		<div class="modal-content custom-modal">

			<!-- Header -->
			<div class="modal-header">
				<h5 class="modal-title fw-bold">تفاصيل الموظف</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<!-- Body -->
			<div class="modal-body p-0">
				<div class="row g-0">

					<input id="employeeId" class="visually-hidden" />

					<!-- Sidebar (Tabs) -->
					<div class="col-3 sidebar">
						<div class="list-group list-group-flush"
							 id="list-tab"
							 role="tablist">

							<a class="list-group-item list-group-item-action active"
							   id="profile-tab"
							   data-bs-toggle="list"
							   href="#profile"
							   role="tab"
							   aria-controls="profile"
							   aria-selected="true">
								البيانات الأساسية
							</a>

							<a class="list-group-item list-group-item-action"
							   id="family-tab"
							   data-bs-toggle="list"
							   href="#family"
							   role="tab"
							   aria-controls="family"
							   aria-selected="false">
								أفراد العائلة
							</a>

							<a class="list-group-item list-group-item-action"
							   id="exceptions-tab"
							   data-bs-toggle="list"
							   href="#exceptions"
							   role="tab"
							   aria-controls="exceptions"
							   aria-selected="false">
								الاستثناءات
							</a>

							<a class="list-group-item list-group-item-action"
							   id="cardNoArchive-tab"
							   data-bs-toggle="list"
							   href="#cardNoArchive"
							   role="tab"
							   aria-controls="cardNoArchive"
							   aria-selected="false">
								أرشيف البطاقات
							</a>

							<a class="list-group-item list-group-item-action"
							   id="others-tab"
							   data-bs-toggle="list"
							   href="#others"
							   role="tab"
							   aria-controls="others"
							   aria-selected="false">
								أخرى
							</a>

						</div>
					</div>

					<!-- Content -->
					<div class="col-9 content-area">
						<div class="tab-content p-4">

							<!-- Profile -->
							<div class="tab-pane fade show active" id="profile">
								<h4 class="section-title">البيانات الأساسية</h4>

								<div class="row g-4">
									<div class="col-md-6">
										<div class="info-card">
											<label>الاسم</label>
											<input class="form-control" disabled id="EmployeeName">
										</div>
									</div>

									<div class="col-md-6">
										<div class="info-card">
											<label>الإدارة</label>
											<input class="form-control" disabled id="EmployeeDepartment">
										</div>
									</div>
								</div>

								<div class="row g-4 mt-1">
									<div class="col-md-3">
										<div class="info-card">
											<label>تاريخ التعيين</label>
											<input class="form-control" disabled id="EmployeeHireDate">
										</div>
									</div>

									<div class="col-md-3">
										<div class="info-card">
											<label>تاريخ الميلاد</label>
											<input class="form-control" disabled id="EmployeeBirthDate">
										</div>
									</div>

									<div class="col-md-3">
										<div class="info-card">
											<label>النوع</label>
											<input class="form-control" disabled id="EmployeeGender">
										</div>
									</div>

									<div class="col-md-3">
										<div class="info-card">
											<label>الحالة الاجتماعية</label>
											<input class="form-control" disabled id="EmployeeMartialStatus">
										</div>
									</div>
								</div>
							</div>

							<!-- Family -->
							<div class="tab-pane fade" id="family">
								<div class="row">
									<div id="nodataBlock"
										 class="col-12 d-flex flex-column justify-content-center align-items-center text-center"
										 style="min-height:300px">
										<h4 class="section-title w-100">أفراد العائلة</h4>
										<h5 class="text-muted">لا يوجد أفراد عائلة مكفولين</h5>
									</div>

									<div id="datafoundBlock" class="col-12 visually-hidden">
										<h4 class="section-title">أفراد العائلة</h4>
										<table class="table table-bordered table-striped">
											<thead>
												<tr>
													<th>#</th>
													<th>الاسم</th>
													<th>النوع</th>
													<th>صلة القرابة</th>
													<th>حالة الكفالة</th>
													<th>تاريخ الميلاد</th>
													<th>العمر</th>
												</tr>
											</thead>
											<tbody id="tblFamilyMembersBody"></tbody>
										</table>
									</div>
								</div>
							</div>

							<!-- Exceptions -->
							<div class="tab-pane fade" id="exceptions">
								<div class="row">
									<div id="exceptionNodataBlock"
										 class="col-12 d-flex flex-column justify-content-center align-items-center text-center"
										 style="min-height:300px">
										<h4 class="section-title w-100">الاستثناءات</h4>
										<h5 class="text-muted">لا يوجد استثناءات</h5>
									</div>

									<div id="exceptionDatafoundBlock" class="col-12 visually-hidden">
										<h4 class="section-title">الاستثناءات</h4>
										<table class="table table-bordered table-striped detailTable">
											<thead>
												<tr>
													<th>#</th>
													<th>الاسم</th>
													<th>نوع الاستثناء</th>
													<th>العام</th>
												</tr>
											</thead>
											<tbody id="tblExceptionsBody"></tbody>
										</table>
									</div>
								</div>
							</div>

							<!-- Card Archive -->
							<div class="tab-pane fade" id="cardNoArchive">
								<div class="row">
									<div id="cardHistoryNodataBlock"
										 class="col-12 d-flex flex-column justify-content-center align-items-center text-center"
										 style="min-height:300px">
										<h4 class="section-title w-100">أرشيف البطاقات</h4>
										<h5 class="text-muted">لا يوجد بطاقات سابقة</h5>
									</div>

									<div id="cardHistoryDatafoundBlock" class="col-12 visually-hidden">
										<h4 class="section-title">أرشيف البطاقات</h4>
										<table class="table table-bordered table-striped ">
											<thead>
												<tr class="text-dark">
													<th>#</th>
													<th>اسم المستفيد</th>
													<th>رقم البطاقة</th>
													<th>السنة</th>
												</tr>
											</thead>
											<tbody id="tblCardNosHistoryBody"></tbody>
										</table>
									</div>
								</div>
							</div>

							<!-- Others -->
							<div class="tab-pane fade" id="others">
								<h4 class="section-title">أخرى</h4>
								<img id="profileImage" class="img-fluid rounded shadow-sm">
							</div>

						</div>
					</div>

				</div>
			</div>

			<!-- Footer -->
			<div class="modal-footer">
				<button class="btn btn-outline-secondary" data-bs-dismiss="modal">إغلاق</button>
				<button class="btn btn-primary">حفظ</button>
			</div>

		</div>
	</div>
</div>


<!-------*****************افراد العائلة***********************-------->
<div class="modal fade" id="familyMemberModel" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-xl" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel4">افراد العائلة</h5>
				<button type="button"
						class="btn-close"
						data-bs-dismiss="modal"
						aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<table id="familyMemberTable" class="table table-sm table-dark table-bordered text-end">
					<thead>
						<tr>
							<th>الرقم</th>
							<th>الاسم </th>
							<th>صلة القرابة </th>
							<th>الحالة الاجتماعية </th>

							<th> اعاقة </th>
