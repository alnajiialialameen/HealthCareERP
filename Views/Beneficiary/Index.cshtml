			  function previewFile(url){
			    var ApiBaseUrl = "@ViewBag.ApiBaseUrl";
				var filePath = `${ApiBaseUrl}${url}`;
				const previewDiv = document.getElementById('preview');
				previewDiv.innerHTML = ''; // مسح القديم
				console.log(filePath);

				// تحديد نوع الملف من الامتداد
				if(!filePath)
				{
					previewDiv.innerHTML = 'نوع الملف غير مدعوم';
					previewDiv.style.color = 'red';
					previewDiv.style.fontSize = '22px';
					return;
				}
				const ext = filePath.split('.').pop().toLowerCase();

				if(['jpg','jpeg','png','gif','bmp'].includes(ext)) {
					const img = document.createElement('img');
					img.src = filePath;
					img.style.maxWidth = '100%';
					img.style.height = 'auto';
					previewDiv.appendChild(img);
				}
				else if(ext === 'pdf') {
					const iframe = document.createElement('iframe');
					iframe.src = filePath + '#toolbar=0&navpanes=0&scrollbar=0';
					iframe.style.width = '100%';
					iframe.style.height = '500px';
					iframe.style.border = 'none';
					previewDiv.appendChild(iframe);
				}
				else {
					previewDiv.innerHTML = 'نوع الملف غير مدعوم';
					previewDiv.style.color = 'red';
					previewDiv.style.fontSize = '22px';
				}
			}



