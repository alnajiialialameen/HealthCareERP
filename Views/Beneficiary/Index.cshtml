				</button>
			</div>
		</div>
	</div>
</div>



<!-------*****************ادارة الامراض لافراد العائلة***********************-------->

<div class="modal fade" id="FamilyBeneficiaryDiseaseModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel3"> ادارة الامراض </h5>
				<button type="button"
						class="btn-close"
						data-bs-dismiss="modal"
						aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<!-- Basic Layout -->
				<form id="formFamilyBeneficiaryDisease" name="formFamilyBeneficiaryDisease" class="needs-validation" novalidate>
					<input id="employeeIdforFamilyMemberDisease" type="hidden" />
					
					<div class="row mb-3">
						<label class="col-sm-2 col-form-label">الأمراض</label>
						<div class="row row-cols-2 row-cols-md-4 row-cols-lg-8 g-2" style="text-align: left;" id="diseaseContainer">
						</div>
					</div>

					<!-- الإعاقة -->
					<div class="row mb-3">
						<label class="col-sm-2 col-form-label">الحالة</label>
						<div class="col-sm-10">
							<div class="form-check">
								<input class="form-check-input" type="checkbox" id="isDisabledForFamily">
								<label class="form-check-label" for="isDisabledForFamily">
									إعاقة
								</label>
							</div>
						</div>
					</div>
					

					
					<div class="row justify-content-end">
						<div class="col-sm-10">
							<button type="submit" class="btn btn-primary">تعديل</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>



<div class="modal fade" id="BeneficiaryDiseaseModal"  tabindex="-1" aria-hidden="true">
