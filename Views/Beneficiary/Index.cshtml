					diseaseId: Number($(this).val()),
					isActive: true
				});
			});

			// ✅ نجيب حالة الإعاقة
			let hasdisability = $('#isDisabledForFamily').is(':checked');

			// 🔄 Loading
			showToast("جاري الحفظ", "يرجى الانتظار...", "info");

