		   function showToast(message, isError = false) {
			 const toastElement = $('#successToast');
			 const toastBody = $('#successToastBody');

			 // تغيير الرسالة
			 toastBody.text(message);

			 // تغيير اللون إذا كان خطأ (اختياري)
			 if (isError) {
				 toastElement.removeClass('bg-success').addClass('bg-danger');
			 } else {
				 toastElement.removeClass('bg-danger').addClass('bg-success');
			 }

			 // تشغيل التوست باستخدام Bootstrap 5 API
			 const toast = new bootstrap.Toast(toastElement[0]);
			 toast.show();
		 }

