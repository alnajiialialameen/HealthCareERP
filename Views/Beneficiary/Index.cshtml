					type: "GET"
				}),

				// 2️⃣ أمراض المستفيد
				$.ajax({
					url: `${apiBaseUrl}api/Disease/DiseasesByBeneficiaryId?Id=${employeeId}`,
					type: "GET"
				}),

				// 3️⃣ بيانات المستفيد (🔥 الجديد)
				$.ajax({
					url: `${apiBaseUrl}api/Beneficiary/${employeeId}`,
					type: "GET"
				})

			).done(function (allDiseasesRes, employeeDiseasesRes, beneficiaryRes) {

				Swal.close();

				const allDiseases = allDiseasesRes[0]?.data || [];
				const employeeDiseases = employeeDiseasesRes[0]?.data || [];
				const beneficiaryData = beneficiaryRes[0]?.data || {};

				let html = '';

				// ✅ عرض الأمراض
				allDiseases.forEach(disease => {

					let isChecked = employeeDiseases.some(x =>
						String(x.id).trim() === String(disease.id).trim()
					);

					html += `
						<div class="col">
							<div class="form-check">
								<input class="form-check-input disease-checkbox"
									   type="checkbox"
									   value="${disease.id}"
									   id="disease_${disease.id}"
									   ${isChecked ? 'checked' : ''}>

								<label class="form-check-label small" for="disease_${disease.id}">
									${disease.name ?? 'غير معروف'}
								</label>
							</div>
						</div>
					`;
				});

				$('#diseaseContainercheckbox').html(html);

				// ✅ ضبط Checkbox الإعاقة
				$('#isDisabled').prop('checked', beneficiaryData.hasDisability === true);

			}).fail(function (err) {

				Swal.close();
				console.log(err);
				Swal.fire('خطأ', 'فشل تحميل البيانات', 'error');
			});
		}











