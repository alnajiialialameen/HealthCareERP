				<button type="button"
						class="btn-close"
						data-bs-dismiss="modal"
						aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form id="formBeneficiaryDisease" name="formBeneficiaryDisease" class="needs-validation" novalidate>

					<input id="employeeIdforDisease" type="hidden" />

					<!-- الأمراض -->
					<div class="row mb-3">
						<label class="col-sm-2 col-form-label">الأمراض</label>
