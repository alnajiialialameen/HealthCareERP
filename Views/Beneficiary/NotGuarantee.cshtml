           function AddFamilyMemberToToBenficaryHasException(e) {      
            e.preventDefault();
             userYearId =$("#userYearId").val();
            const form = document.getElementById('formAddException');

            // 2️⃣ Bootstrap Validation
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            // 3️⃣ Validation خاص لـ Select2
            if (!$('#addexception').val()) {
                $('#addexception').addClass('is-invalid');
                return;
            } else {
                $('#addexception').removeClass('is-invalid').addClass('is-valid');
            }

            // 4️⃣ Validation الملف
            var fileInput = $('#file-upload')[0].files[0];
            if (!fileInput) {
                $('#file-upload').addClass('is-invalid');
                return;
            } else {
                $('#file-upload').removeClass('is-invalid').addClass('is-valid');
            }

            // ===============================
            // 5️⃣ جلب القيم
            // ===============================
            var apiBaseUrl = "@ViewBag.ApiBaseUrl";

            var addFamilymemeberid = $('#addFamilymemeberid').val();
            var addFamilymemebername = $('#addFamilymemebername').val();
            var ExceptionTypeId = $('#addexception').val();
            var ClientParentId = $('#addFamilymemeberemployeeId').val();
              var RelativeRelationId = $('#addFamilymemeberrelativeRelationId').val();
            
            // ===============================
            // 6️⃣ إنشاء FormData
            // ===============================
            var formData = new FormData();

            formData.append("ClientId", parseInt(addFamilymemeberid));
            formData.append("YearId", userYearId);
            formData.append("Name", addFamilymemebername);
            formData.append("IsStoped", "false");
            formData.append("IsEmployee", "false");
            formData.append("ClientParentId", ClientParentId);
            formData.append("ExceptionTypeId", ExceptionTypeId);
            formData.append("ReportPath", fileInput);
            formData.append("RelativeRelationId", RelativeRelationId);

            // ===============================
            // 7️⃣ SweetAlert Loading
            // ===============================
            Swal.fire({
                title: 'جاري الحفظ...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            // ===============================
            // 8️⃣ Ajax Request
            // ===============================
            $.ajax({
                  url: `${apiBaseUrl}api/Beneficiary`,
                 // url: "https://localhost:2001/api/Beneficiary/",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    Swal.close();

                    if (res.status === "Success") {
                        $('#exceptionModal').modal('hide');
                        $('#familyMemberTable').DataTable().ajax.reload(null, false);

                        // تنظيف الفورم
                        form.reset();
                        form.classList.remove('was-validated');
                        $('.is-valid, .is-invalid').removeClass('is-valid is-invalid');

                        showToast('نجاح', 'تمت إضافة الاستثناء بنجاح', 'success');
                    } else {
                        showToast('خطأ', 'حدث خطأ أثناء الحفظ', 'error');
                    }
                },
                error: function () {
                    Swal.close();
                    showToast('خطأ', 'حدث Exception أثناء الحفظ', 'error');
                }
            });
        }





                  function getExceptionId() {
                 
            $('#addexception').empty();
            $('#addexception').append('<option value="-1" selected disabled>-- اختر الاستثناء --</option>');

            var apiBaseUrl = "@ViewBag.ApiBaseUrl";

            $.ajax({
                url: apiBaseUrl + "api/ExceptionType",
                type: "GET",
                success: function (result) {

                    if (result.status !== "Success" || !result.data) return;

                    var html = "";

                    $.each(result.data, function (key, item) {

                        // تجاهل القيم الفارغة
                        if (item.name && item.name.trim() !== "") {
                            html += `<option value="${item.id}">${item.name}</option>`;
                        }
                    });

                    $('#addexception').append(html);

                    if ($('#addexception').hasClass("select2-hidden-accessible")) {
                        $('#addexception').trigger('change.select2');
                    }
                },
                error: function (err) {
                    console.error(err.responseText);
                }
            });
        }

                      $('#exceptionModal').on('hidden.bs.modal', function () {
            const form = document.getElementById('formAddException');
            form.reset();
            form.classList.remove('was-validated');
            $('.is-valid, .is-invalid').removeClass('is-valid is-invalid');
        });


                (() => {
            'use strict';

            const forms = document.querySelectorAll('.needs-validation');

            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {

                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    form.classList.add('was-validated');

                }, false);
            });
        })();





    </script>
