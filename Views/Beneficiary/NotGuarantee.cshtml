</style>

<input id="userYearId" name="userYearId" hidden type="text" />
<div class="row">
    <div class="col-lg-12 mb-4 order-0">
        <div class="card">
            <div class="card-body">
                <h4>ادارة  غير المكفولين</h4>

                <table id="myTable" class="table table-bordered table-dark">
                    <thead>
                        <tr>
                            <th>الرقم</th>
                            <th>الاسم </th>
                            <th>الجنس </th>
                            <th>الادارة </th>
                            <th>مضاف </th>
                            <th>عمليات</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="familyMemberModel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel4">افراد العائلة</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="familyMemberTable" class="table table-danger table-bordered  table-dark" style="width:100% ;font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif">
                    <thead>
                        <tr>
                            <th>الرقم</th>
                            <th>الاسم </th>
                            <th>صلة القرابة </th>
                            <th>الحالة الاجتماعية </th>
                            <th>مضاف</th>
                            <th>عمليات</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="exceptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel3">اضافة استثناء</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                        <!-- Basic Layout -->
                <form id="formAddException" name="formAddException" class="needs-validation" novalidate>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="addFamilymemebernameshow">Name</label>
                        <div class="col-sm-10">
                            <input type="text"
                                   class="form-control"
                                   id="addFamilymemebernameshow"
                                   readonly
                                   required />

                            <div class="invalid-feedback">
                                الاسم مطلوب
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="addexception">الاستثناء</label>
                        <div class="col-sm-10">
                            <select class="form-control select2"
                                    id="addexception"
                                    name="addexception"
                                    required>
                            </select>

                            <div class="invalid-feedback">
                                الرجاء اختيار نوع الاستثناء
                            </div>


                        </div>
                    </div>
                    <input id="addFamilymemeberid" name="addFamilymemeberid" hidden type="text" />
                    <input id="addFamilymemebername" name="addFamilymemebername" hidden type="text" />
                    <input id="addFamilymemeberemployeeId" name="addFamilymemeberemployeeId" hidden type="text" />
                    <input id="addFamilymemeberrelativeRelationId" name="addFamilymemeberrelativeRelationId" hidden type="text" />
                    
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="file-upload">الملف</label>
                        <div class="col-sm-10">
                            <input type="file"
                                   class="form-control"
                                   id="file-upload"
                                   name="user_file"
                                   required />

                            <div class="invalid-feedback">
                                الرجاء رفع ملف
                            </div>

                        </div>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-sm-10">
                            <button type="submit" class="btn btn-primary">اضافة</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

