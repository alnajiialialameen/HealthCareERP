            function addSearchControl(json) {

            $('#myTable thead').append($('#myTable thead tr:first').clone());

            $('#myTable thead tr:eq(1) th').each(function (index) {

                // أعمدة بدون بحث
                if ([0,2,4,5,6].includes(index)) {
                    $(this).html('');
                    return;
                }

              
                if (index === 3) {

                            let select = $('<select class="form-select form-select-sm"><option value="">الكل</option></select>');
                            let values = [];

                            $.each(json.data, function (i, item) {
                                        if (item.departmentName && !values.includes(item.departmentName)) {
                                        values.push(item.departmentName);
                                    select.append(
                                        $('<option/>')
                                                .val(item.departmentName)
                                                .text(item.departmentName)
                                    );
                                }
                            });

                            $(this).html(select);

                            $('select', this).on('change', function () {
                                let val = $(this).val();
                                dataTable
                                    .column(index)
                                    .search(val ? '^' + val + '$' : '', true, false)
                                    .draw();
                            });

                            return;
                        }

                         
                /* 🔍 INPUT لبقية الأعمدة */
                $(this).html('<input type="text" class="form-control form-control-sm" placeholder="بحث" />');

                $('input', this).on('keyup change', function () {
                    dataTable.column(index).search(this.value).draw();
                });

            });
        }



