        /// عرض بيانات العائلة عن الضغط علي الزر
          function AddFamilyMember(employeeId) 
          {
            var apiBaseUrl = "@ViewBag.ApiBaseUrl";
            var HrAPIUrl = "@ViewBag.HrAPIUrl";
             userYearId =$("#userYearId").val();
            Swal.fire({
                target: '#familyMemberModel', // 👈 مهم جدًا
                title: 'جاري جلب البيانات...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: `${HrAPIUrl}api/FamilyMembers/${employeeId}`,
                type: "GET",
                success: function (response) {

                    if (response.status !== "Success" || !response.data) {
                        Swal.close();
                        Swal.fire('خطأ', 'تعذر جلب بيانات الموظف', 'error');
                        return;
                    }

                    const employee = response.data;
                   // alert(employee.relativeRelationId);

                    // ===============================
                    // 1️⃣ التحقق من البيانات
                    // ===============================
                    let errors = [];

                    const bDate = employee.birthDate;
                    const gId = 1;
                    const mStatusId = employee.maritalStatusId;

                    if (!bDate || bDate.trim?.() === "") {
                        errors.push("تاريخ الميلاد مفقود");
                    } else {
                        const parsedDate = new Date(bDate);
                        if (isNaN(parsedDate.getTime())) {
                            errors.push("تاريخ الميلاد غير صالح");
                        }
                    }

                    if (!gId || Number(gId) === 0) {
                        errors.push("يرجى تحديد جنس الموظف");
                    }

                    if (!mStatusId || Number(mStatusId) === 0) {
                        errors.push("يرجى تحديد الحالة الاجتماعية");
                    }

                    if (errors.length > 0) {
                        Swal.close();
                        showToast("بيانات ناقصة", errors.join(" • "), true);
                        return;
                    }
                    //alert(employee.employeeId);
                    // ===============================
                    // 2️⃣ تجهيز FormData
                    // ===============================
                    var formData = new FormData();
                    formData.append("ClientId", employee.id);
                    formData.append("Name", employee.name);
                    formData.append("IsStoped", false);
                    formData.append("YearId", userYearId);
                    formData.append("IsEmployee", false);
                    formData.append("BirthDate", bDate);
                    formData.append("GenderId", gId);
                    formData.append("MaritalStatusId", mStatusId);
                    formData.append("ClientParentId", employee.employeeId);
                     formData.append("RelativeRelationId", employee.relativeRelationId);
                
                    Swal.fire({
                        target: '#familyMemberModel', 
                        title: 'جاري الحفظ...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    // ===============================
                    // 3️⃣ إرسال البيانات
                    // ===============================
                    $.ajax({
                         url: `${apiBaseUrl}api/Beneficiary`, // ❌ لم يتم التعديل
                       // url: "https://localhost:2001/api/Beneficiary/",
                        type: "POST",
                        data: formData,
                        processData: false,
                        contentType: false,

                        success: function (res) {
                            Swal.close();

                            if (res.status === "Success" || res.status === "success") {
                                $('#familyMemberTable').DataTable().ajax.reload(null, false);
                                showToast("تمت الإضافة بنجاح");
                            } else {
                                Swal.fire({
                                    title: 'غير مطابق للشروط',
                                    html: `
                                        <div style="text-align:right">
                                            <p class="text-danger">${res.message}</p>
                                            <p>هل تريد فتح طلب استثناء؟</p>
                                        </div>
                                    `,
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonText: 'نعم',
                                    cancelButtonText: 'إلغاء'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        ///---------------------غير ------------------
                                        $('#exceptionModal').modal('show');
                                        $('#addFamilymemeberid').val(employee.id);
                                        $('#addFamilymemebername').val(employee.name);
                                        $('#addFamilymemebernameshow').val(employee.name);
                                       
                                    }
                                });
                            }
                        },

                        error: function (res) {

                            Swal.close();

                          
                            console.log(res.responseJSON);

                            const apiResponse = res.responseJSON;

                            const message =
                                apiResponse?.message ||
                                apiResponse?.Message ||
                                'حدث خطأ غير متوقع';

                            Swal.fire({
                                target: '#familyMemberModel', // 👈 مهم جدًا
                                title: 'غير مطابق للشروط',
                                html: `
                                    <div style="text-align:right">
                                        <p class="text-danger">${message}</p>
                                        <p>هل تريد فتح طلب استثناء؟</p>
                                    </div>
                                `,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonText: 'نعم',
                                cancelButtonText: 'إلغاء'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                  
                                    ///الكود الحقيقي
                                    $('#exceptionModal').modal('show');
                                    $('#addFamilymemeberid').val(employee.id);
                                    $('#addFamilymemebername').val(employee.name);
                                    $('#addFamilymemebernameshow').val(employee.name);
                                    $('#addFamilymemeberemployeeId').val(employee.employeeId);
                                      $('#addFamilymemeberrelativeRelationId').val(employee.relativeRelationId);

                                    
                                       getExceptionId();
                                }
                            });
                        }
                    });
                },

                error: function () {
                    Swal.close();
                    Swal.fire('خطأ', 'فشل الاتصال بسيرفر بيانات الموظفين', 'error');
                }
            });
        }











