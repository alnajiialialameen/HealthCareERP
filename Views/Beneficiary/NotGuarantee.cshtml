            function showToast(title, message, type = 'success') {

            const toastElement = $('#mainToast');
            const toastTitle = $('#toastTitle');
            const toastBody  = $('#toastBody');
            const toastIcon  = $('#toastIcon');

            // تعيين العنوان والنص
            toastTitle.text(title);
            toastBody.text(message);

            // إزالة أي ألوان أو أيقونات قديمة
            toastElement.removeClass('bg-success bg-danger bg-warning bg-info');
            toastIcon.removeClass('bx-check bx-error bx-info-circle bx-error-circle');

            // تحديد النوع
            switch (type) {
                case 'success':
                    toastElement.addClass('bg-success');
                    toastIcon.addClass('bx bx-check');
                    break;

                case 'error':
                    toastElement.addClass('bg-danger');
                    toastIcon.addClass('bx bx-error-circle');
                    break;

                case 'warning':
                    toastElement.addClass('bg-warning');
                    toastIcon.addClass('bx bx-error');
                    break;

                case 'info':
                    toastElement.addClass('bg-info');
                    toastIcon.addClass('bx bx-info-circle');
                    break;
            }

            // تشغيل Toast
            const toast = new bootstrap.Toast(toastElement[0]);
            toast.show();
        }

