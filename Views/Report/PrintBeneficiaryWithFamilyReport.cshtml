@{
    ViewBag.Title = "PrintInvoice";
    Layout = null;
}

<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #fff;
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .report-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        /* ===== الهيدر ===== */
        .report-header {
            border-bottom: 3px solid #0c3da3;
            padding-bottom: 20px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title {
            border: 2px solid #0c3da3;
            border-radius: 15px;
            padding: 15px;
            font-size: 22px;
            font-weight: bold;
            color: #0c3da3;
            text-align: center;
            min-width: 300px;
        }

        /* ===== الجدول ===== */
        .table-section {
            margin-top: 20px;
        }

        .my-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            border: 1.5px solid #222;
        }

            .my-table th {
                background-color: #fff !important;
                color: #222;
                font-weight: bold;
                border: 1px solid #222;
                padding: 12px;
                text-align: center;
            }

            .my-table td {
                border: 1px solid #333;
                padding: 10px;
                text-align: center;
                font-size: 18px;
                color: #222;
            }

        /* ===== الطباعة ===== */
        @@media print {
            body {
                padding: 0;
            }

            .my-table,
            .my-table th,
            .my-table td {
                border: 1px solid #222 !important;
                -webkit-print-color-adjust: exact;
            }

                .my-table th {
                    background-color: #fff !important;
                    color: #222;
                    font-family: 'Times New Roman';
                }









            .btn-print {
                display: none !important;
            }

            .report-header {
                border-bottom: 3px solid #0c3da3 !important;
                -webkit-print-color-adjust: exact;
            }
        }
    </style>
</head>

<body>

    <div class="report-container">

        <!-- ===== Header ===== -->
        <header class="report-header">
            <div class="logo-right">
                <img src="~/images/WhiteLogo.jpg" height="80" alt="Logo" />
            </div>

            <div class="header-title">
                الادارة العامة للشؤون الادارية <br />
                ادارة الرعاية الطبية
            </div>

            <div class="logo-left">
                <img src="~/images/WhiteLogo.jpg" height="80" alt="Logo" />
            </div>
        </header>

        <!-- ===== Table Section ===== -->
        <section class="table-section">
            <h3 class="text-center mb-4"><u>قائمة المكفوليين</u></h3>

            <!-- Loader -->
            <div id="tableLoader" class="text-center my-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 fw-bold">جاري تحميل البيانات...</div>
            </div>

            <!-- Table -->
            <div id="tableContainer" style="display:none;">
                <table id="targetTable" class="my-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>الجنس</th>
                            <th>الحالة الاجتماعية</th>
                            <th>افراد العائلة المكفوليين</th>
                            <th>القسم</th>
                           
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script>
        $(document).ready(function () {

            var apiBaseUrl = "@ViewBag.ApiBaseUrl";

            // إظهار اللودر
            $('#tableLoader').show();
            $('#tableContainer').hide();

            $.ajax({
                url: apiBaseUrl + "api/Report/GetBeneficiaryWithFamily",
                 // url:"https://localhost:2001/api/Report/GetBeneficiaryWithFamily",
                type: "GET",
                data: {
                    BeneficiaryId: '@ViewBag.BeneficiaryId'
                    // BeneficiaryType: '@ViewBag.BeneficiaryType'
                },
                success: function (response) {

                    if (response.status === "Success") {
                        renderTable(response.data);

                        // إخفاء اللودر
                        $('#tableLoader').hide();
                        $('#tableContainer').show();

                        setTimeout(function () {
                            window.print();
                        }, 500);
                    }
                },
                error: function (xhr) {
                    $('#tableLoader').hide();
                    console.error("خطأ في جلب البيانات:", xhr.responseText);
                }
            });
        });

                 function renderTable(data) 
                 {
            var rows = '';

            $.each(data, function (index, item) {

                let familyHtml = '-';

                if (item.familyMembers && item.familyMembers.length > 0) {
                    familyHtml = item.familyMembers.map((f, i) => `
                        <div>
                            ${i + 1} - ${f.name} (${f.relativeRelationName})
                        </div>
                    `).join('');
                }

                rows += `
                    <tr>
                        <td>${index + 1}</td>
                        <td>${item.employeeName ?? '-'}</td>
                        <td>${item.genderName ?? '-'}</td>
                        <td>${item.martialStatusName ?? '-'}</td>
                        <td>${familyHtml}</td>
                        <td>${item.departmentName ?? '-'}</td>
                    </tr>`;
            });

            $('#targetTable tbody').html(rows);
        }


                    






    </script>

</body>
</html>
