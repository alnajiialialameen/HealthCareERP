                   $(document).ready(function () {
            // تفعيل Select2
            $('#BeneficiaryId').select2({
                width: '100%',
                placeholder: '-- اختر الموظف --',
                allowClear: true
            });

            getBeneficiary();
        });

        function getBeneficiary() {
            var apiBaseUrl = "@ViewBag.ApiBaseUrl";
            var $deptSelect = $('#BeneficiaryId');

            // 🔹 إضافة class للتحميل
            $deptSelect.addClass('select2-container--loading');

            // عرض خيار مؤقت مع spinner
            $deptSelect.empty();
            $deptSelect.append('<option selected><span class="spinner-select2"></span> جاري التحميل...</option>');

            // تحديث Select2 ليظهر النص مع spinner
            $deptSelect.trigger('change');

            $.ajax({
                url: apiBaseUrl + "api/Beneficiary/GetEmployeesEnteredOnly",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",

                success: function (result) {
                    $deptSelect.removeClass('select2-container--loading');
                    $deptSelect.empty();
                    $deptSelect.append('<option value="-1" selected>-- الموظف--</option>');

                    if (result && result.data) {
                        $.each(result.data, function (key, item) {
                            $deptSelect.append(`<option value="${item.id}">${item.name}</option>`);
                        });
                    }

                    $deptSelect.val("-1").trigger('change');
                },

                error: function () {
                    $deptSelect.removeClass('select2-container--loading');
                    $deptSelect.empty();
                    $deptSelect.append('<option selected>حدث خطأ في تحميل البيانات</option>');
                    $deptSelect.trigger('change');
                }
            });
        }


         

          
        $(document).ready(function () {

            $('#btnsearch').on('click', function () {

        // إظهار اللودر
                $('#tableLoader').show();
                $('#tableContainer').hide();

            var apiBaseUrl = "@ViewBag.ApiBaseUrl";
            var BeneficiaryId = $('#BeneficiaryId').val();
            // var departmentId = $('#DepartmentId').val();

            $.ajax({
                url: apiBaseUrl + "api/Report/GetBeneficiaryWithFamily",
                type: "GET",
                data: {
                    BeneficiaryId: BeneficiaryId
                    // DepartmentId: departmentId
                },
                success: function (response) {

                    if (response.status === "Success") {
                      
                        renderTable(response.data);


                           // إخفاء اللودر
                        $('#tableLoader').hide();
                        $('#tableContainer').show();


                    } else {
                        alert(response.message);
                    }

                },
                error: function (xhr) {
                    console.error(xhr);
                    alert("حدث خطأ أثناء جلب البيانات");
                }
            });

        });



               function renderTable(data) {

            var tbody = $('#resultTable tbody');
            tbody.empty();

            if (data.length === 0) {
                tbody.append(`
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            لا توجد بيانات
                        </td>
                    </tr>
                `);
                return;
            }

                 $.each(data, function (index, item) {

            let familyHtml = '-';

            if (item.familyMembers && item.familyMembers.length > 0) {
                familyHtml = item.familyMembers.map((f, i) => `
                    <div>
                        ${i + 1} - ${f.name} (${f.relativeRelationName})
                    </div>
                `).join('');
            }

            tbody.append(`
                <tr>
                    <td>${index + 1}</td>
                    <td>${item.employeeName ?? '-'}</td>
                    <td>${item.genderName ?? '-'}</td>
                    <td>${item.martialStatusName ?? '-'}</td>
                    <td>${familyHtml}</td>
                    <td>${item.departmentName ?? '-'}</td>
                </tr>
            `);
        });
        }




        });




            function PrintData() {

            var BeneficiaryId = $('#BeneficiaryId').val();
            // var departmentId = $('#DepartmentId').val();

            if (!BeneficiaryId) {
                alert("يرجى تنفيذ البحث أولاً");
                return;
            }

            var url = '/Report/PrintBeneficiaryWithFamilyReport'
                + '?BeneficiaryType=' + encodeURIComponent(BeneficiaryId)
                // + '&DepartmentId=' + encodeURIComponent(departmentId);

            // window.location.href = url;
            window.open(url, '_blank');
        }















     





    </script>

