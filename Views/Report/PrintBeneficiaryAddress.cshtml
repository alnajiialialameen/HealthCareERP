@{
    ViewBag.Title = "PrintInvoice";
    Layout = null;
}

<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #fff;
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .report-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        /* ===== الهيدر ===== */
        .report-header {
            border-bottom: 3px solid #0c3da3;
            padding-bottom: 20px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-title {
            border: 2px solid #0c3da3;
            border-radius: 15px;
            padding: 15px;
            font-size: 22px;
            font-weight: bold;
            color: #0c3da3;
            text-align: center;
            min-width: 300px;
        }

        /* ===== الجدول ===== */
        .table-section {
            margin-top: 20px;
        }

            .my-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            border: 1.5px solid #222;
           }

            .my-table th {
                background-color: #fff !important;
                color: #222;
                font-weight: bold;
                border: 1px solid #222;
                padding: 12px;
                text-align: center;
            }

            .my-table td {
                border: 1px solid #333;
                padding: 10px;
                text-align: center;
                font-size: 18px;
                color: #222;
            }

        /* ===== الطباعة ===== */
        @@media print {
            body

        {
            padding: 0;
        }

        .my-table,
        .my-table th,
        .my-table td {
            border: 1px solid #222 !important;
            -webkit-print-color-adjust: exact;
        }

            .my-table th {
                background-color: #fff !important;
                color:#222;
                font-family:'Times New Roman';
            }









        .btn-print {
            display: none !important;
        }

        .report-header {
            border-bottom: 3px solid #0c3da3 !important;
            -webkit-print-color-adjust: exact;
        }

        }
    </style>
</head>

<body>

    <div class="report-container">

        <!-- ===== Header ===== -->
        <header class="report-header">
            <div class="logo-right">
                <img src="~/images/WhiteLogo.jpg" height="80" alt="Logo" />
            </div>

            <div class="header-title">
                الادارة العامة للشؤون الادارية <br />
                ادارة الرعاية الطبية
            </div>

            <div class="logo-left">
                <img src="~/images/WhiteLogo.jpg" height="80" alt="Logo" />
            </div>
        </header>

        <!-- ===== Table Section ===== -->
        <section class="table-section">
            <h3 class="text-center mb-4"><u>قائمة المكفوليين حسب السكن</u></h3>

            <!-- Loader -->
            <div id="tableLoader" class="text-center my-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 fw-bold">جاري تحميل البيانات...</div>
            </div>

            <!-- Table -->
            <div id="tableContainer" style="display:none;">
                <div>
                    @{
                        if (ViewBag.RegionId != null)
                        {
                            <label class="fw-bold RegionName"></label>
                        }

                        if (ViewBag.HousingId != null)
                        {
                            <label class="fw-bold HousingName"></label>
                        }
                    }
                </div>
                <table id="targetTable" class="my-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>الولاية</th>
                            <th>المحلية</th>
                            <th>القرية او العنوان</th>
                            <th>عدد المكفلوين</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script>
        $(document).ready(function () {

            // إظهار اللودر
            $('#tableLoader').show();
            $('#tableContainer').hide();

            var apiBaseUrl = "@ViewBag.ApiBaseUrl";
            var RegionId = "@ViewBag.RegionId";
            var HousingId = "@ViewBag.HousingId";
            // إظهار اللودر
            $('#tableLoader').show();
            $('#tableContainer').hide();

            var url = `${apiBaseUrl}api/Report/GetBeneficiariesByAddress?RegionId=${RegionId}&&HousingId=${HousingId}`;

            $.ajax({
                url: url,
                type: "GET",
                success: function (response) {
                    if (response.status === "Success") {
                        renderTable(response.data);
                        // إخفاء اللودر
                        $('#tableLoader').hide();
                        $('#tableContainer').show();
                    } else {
                        alert(response.message);
                        $('#tableLoader').hide();
                    }
                },
                error: function (xhr) {
                    console.error(xhr);
                    alert("حدث خطأ أثناء جلب البيانات");
                    $('#tableLoader').hide();
                }
            });

        });

        function renderTable(data) {
            var rows = '';
             $.each(data, function (index, item) {
                 rows+= `<tr>
                         <td>${index + 1}</td>
                         <td>${item.employeeName ?? '-'}</td>
                         <td>${item.regionName ?? '-'}</td>
                         <td>${item.housingName ?? '-'}</td>
                         <td>${item.address ?? '-'}</td>
                         <td>${item.familyMembers ? item.familyMembers.length : '-'}</td>
                     </tr>`;
             });

            $('#targetTable tbody').html(rows);

            var housingId = "@ViewBag.HousingId";
            var regionId = "@ViewBag.RegionId";

            $('.HousingName').text(`المحلية: ${housingId != null? data[0].housingName : '-'}`);
            $('.RegionName').text(`الولاية: ${regionId != null ? data[0].regionName : '-'}`);
        }
    </script>

</body>
</html>
