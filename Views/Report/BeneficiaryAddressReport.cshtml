<style>
    .card-header {
        border-bottom: 1px solid #e9ecef;
    }

    .form-label {
        color: #212529;
    }

    .select2-container--bootstrap4 .select2-selection {
        min-height: 38px;
        padding: 4px 10px;
    }

    .my-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        border: 1.5px solid #222;
    }

        .my-table th {
            background-color: #fff !important;
            color: #222;
           
            border: 1px solid #222;
            padding: 12px;
            text-align: center;
            font-family:'Times New Roman';
        }

        .my-table td {
            border: 1px solid #333;
            padding: 10px;
            text-align: center;
            font-size: 14px;
            color: #222;
        }




</style>
<section class="content">

    <div class="card shadow-sm border-0">

        <!-- Header -->
        <div class="card-header bg-light fw-bold">
            <i class="bx bx-filter-alt me-1"></i>
            خيارات البحث
        </div>

        <div class="card-body p-4">
            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="RegionId" class="form-label fw-bold mb-2 text-dark">الولاية</label>
                    <select class="form-select select2" id="RegionId">
                        <option value="">-- اختر الولاية --</option>
                    </select>
                </div>

                <div class="col-md-5">
                    <label for="HousingId" class="form-label fw-bold mb-2 text-dark">المحلية</label>
                    <select class="form-select select2" id="HousingId">
                        <option value="">-- اختر المحلية --</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button id="btnsearch" class="btn btn-primary flex-fill custom-btn-height">
                            <i class="bx bx-search-alt-2"></i> بحث
                        </button>
                        <button id="btnReport" onclick="PrintData()" class="btn btn-outline-secondary flex-fill custom-btn-height">
                            <i class="bx bxs-report"></i> طباعة
                        </button>
                    </div>
                </div>

            </div>
        </div>


        <!-- Loader -->
        <div id="tableLoader" class="text-center my-3" style="display:none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="mt-2 fw-bold">جاري تحميل البيانات...</div>
        </div>

        <div id="tableContainer">
            <table class="table table-bordered my-table mt-4" id="resultTable">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>الاسم</th>
                    <th>الولاية</th>
                    <th>المحلية</th>
                    <th>القرية او العنوان</th>
                    <th>عدد المكفلوين</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        </div>






    </div>

</section>

@section scripts {

    <script language="javascript" type="text/javascript">

           $(document).ready(function () {
            // تفعيل Select2
            $('.select2').select2({
                width: '100%',
                // placeholder: '-- اختر الولاية --',
                allowClear: true
            });

           

              getHousing();
             getRegion();
        });








        function getHousing() {
            var HrAPIUrl = "@ViewBag.HrAPIUrl";
            var $housingSelect = $('#HousingId'); // تخزين العنصر في متغير لسهولة الاستخدام

            $housingSelect.empty();
            // إضافة القيمة الافتراضية
            $housingSelect.append('<option value="" selected>-- المحلية --</option>');

            $.ajax({

                url: HrAPIUrl + "api/Shared/GetAllHousing",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result && result.data) {
                        var html = "";

                        $.each(result.data, function (key, item) {
                            html += "<option value='" + item.id + "'>" + item.name + "</option>";
                        });

                        // الإصلاح: الإضافة للعنصر الصحيح
                        $housingSelect.append(html);

                        // الإصلاح: تحديث Select2 بشكل صحيح
                        if ($housingSelect.hasClass("select2-hidden-accessible")) {
                            // $housingSelect.val("-1").trigger('change');
                        }
                    }
                },
                error: function (errormessage) {
                    console.error("Error: ", errormessage.responseText);
                }
            });
        }

        function getRegion() {
            var HrAPIUrl = "@ViewBag.HrAPIUrl";
            var $regionSelect = $('#RegionId'); // تخزين العنصر في متغير لسهولة الاستخدام

            $regionSelect.empty();
            // إضافة القيمة الافتراضية
            $regionSelect.append('<option value="" selected>-- الولاية --</option>');

            $.ajax({

                url: HrAPIUrl + "api/Shared/GetAllRegions",
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result && result.data) {
                        var html = "";

                        $.each(result.data, function (key, item) {
                            html += "<option value='" + item.id + "'>" + item.name + "</option>";
                        });

                        // الإصلاح: الإضافة للعنصر الصحيح
                        $regionSelect.append(html);

                        // الإصلاح: تحديث Select2 بشكل صحيح
                        if ($regionSelect.hasClass("select2-hidden-accessible")) {
                            // $regionSelect.val("-1").trigger('change');
                        }
                    }
                },
                error: function (errormessage) {
                    console.error("Error: ", errormessage.responseText);
                }
            });
        }

        $(document).ready(function () {

            $('#btnsearch').on('click', function () {

            // إظهار اللودر
            $('#tableLoader').show();
            $('#tableContainer').hide();

            var apiBaseUrl = "@ViewBag.ApiBaseUrl";
            var RegionId = $('#RegionId').val();
            var HousingId = $('#HousingId').val();
            var url = `${apiBaseUrl}api/Report/GetBeneficiariesByAddress?RegionId=${RegionId}&&HousingId=${HousingId}`;
            
            $.ajax({
                url: url,
                type: "GET",
                success: function (response) {
                    if (response.status === "Success") {
                        renderTable(response.data);
                        // إخفاء اللودر
                        $('#tableLoader').hide();
                        $('#tableContainer').show();
                    } else {
                        alert(response.message);
                    }
                },
                error: function (xhr) {
                    console.error(xhr);
                    alert("حدث خطأ أثناء جلب البيانات");
                }
            });
        });

        function renderTable(data) {

             var tbody = $('#resultTable tbody');
             tbody.empty();

             if (data.length === 0) {
                 tbody.append(`
                     <tr>
                         <td colspan="6" class="text-center text-muted">
                             لا توجد بيانات
                         </td>
                     </tr>
                 `);
                 return;
             }

             $.each(data, function (index, item) {
                 tbody.append(`
                     <tr>
                         <td>${index + 1}</td>
                         <td>${item.employeeName ?? '-'}</td>
                         <td>${item.regionName ?? '-'}</td>
                         <td>${item.housingName ?? '-'}</td>
                         <td>${item.address ?? '-'}</td>
                         <td>${item.familyMembers ? item.familyMembers.length : '-'}</td>
                     </tr>
                 `);
             });
         }

        });

        function PrintData() {
            var RegionId = $('#RegionId').val();
            var HousingId = $('#HousingId').val();

                // if (!BeneficiaryType && !departmentId) {
                //     alert("يرجى تنفيذ البحث أولاً");
                //     return;
                // }

                    var url = '/Report/PrintBeneficiaryAddress'
                        + '?RegionId=' + RegionId
                        + '&&HousingId=' + HousingId;

                // window.location.href = url;
                window.open(url, '_blank');
        }

    </script>
}
